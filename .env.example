# Optional: build your own Google OAuth client into Take1, so people using your copy
# just sign in with Google to upload (no setup on their side). Copy this file to `.env`.
#
# Browser (npm run dev / build): an OAuth client of type "Web application", with your
# site's address (e.g. http://localhost:5173) under "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Desktop app (npm run app): an OAuth client of type "Desktop app". Google does not treat
# a desktop client's secret as confidential; it is shipped with the app.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
