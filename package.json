{
  "name": "take1",
  "private": true,
  "version": "0.2.0",
  "description": "Take1: a screen recorder you control with your voice. Say cut to redo a sentence, pause, speed up waits, blur and zoom while recording.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "app:dev": "concurrently -k -n web,app \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env TAKE1_DEV_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --win --x64",
    "dist:dir": "vite build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.0.0",
    "@fontsource/bebas-neue": "^5.0.0",
    "@fontsource/figtree": "^5.0.0",
    "@fontsource/montserrat": "^5.0.0",
    "@fontsource/permanent-marker": "^5.0.0",
    "@fontsource/poppins": "^5.0.0",
    "@huggingface/transformers": "^3.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "author": "Sawant",
  "homepage": "https://github.com/ScRocXx/Take1",
  "build": {
    "appId": "app.take1.recorder",
    "productName": "Take1",
    "copyright": "Sawant",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Take1",
      "runAfterFinish": true,
      "artifactName": "Take1-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": null
  }
}
