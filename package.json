{
  "name": "take1",
  "private": true,
  "version": "0.2.0",
  "description": "Take1: a screen recorder you control with your voice. Say cut to redo a sentence, pause, speed up waits, blur and zoom while recording.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "app:dev": "concurrently -k -n web,app \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env TAKE1_DEV_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.0.0",
    "@fontsource/bebas-neue": "^5.0.0",
    "@fontsource/figtree": "^5.0.0",
    "@fontsource/montserrat": "^5.0.0",
    "@fontsource/permanent-marker": "^5.0.0",
    "@fontsource/poppins": "^5.0.0",
    "@huggingface/transformers": "^3.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
